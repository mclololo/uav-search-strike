<launch>
    <!-- 任务参数配置 -->
    <param name="goal_topic" value="/move_base_simple/goal" type="str"/>
    <param name="planner_cmd_topic" value="/planning/pos_cmd" type="str"/>
    <param name="visual_servo/depth_topic" value="/rflysim/sensor0/Depth_Cloud" type="str"/>
    <!-- sensor0 depth is 640x640/80deg; project 3-D rays into sensor1 RGB at 640x480/90deg -->
    <param name="visual_servo/rgb_hfov_deg" value="90.0" type="double"/>
    <param name="visual_servo/depth_image_y_sign" value="1.0" type="double"/>
    <param name="visual_servo/depth_image_z_sign" value="1.0" type="double"/>

    <!-- 相机内参 (640x480, 90° FOV) -->
    <param name="fx" value="320.0" type="double"/>
    <param name="fy" value="320.0" type="double"/>
    <param name="cx" value="320.0" type="double"/>
    <param name="cy" value="240.0" type="double"/>

    <!-- 相机外参：相机到机体坐标系的变换 (ENU 机体系) -->
    <rosparam param="cam2body_R">[0,0,1, -1,0,0, 0,-1,0]</rosparam>
    <rosparam param="cam2body_T">[0.1, 0.04, 0.05]</rosparam>

    <!-- 目标检测话题 -->
    <param name="detect_result_topic" value="/objects" type="str"/>
    <param name="mission_debug_topic" value="/mission_debug" type="str"/>

    <!-- 到达判定容差 -->
    <param name="tolerance" value="0.15" type="double"/>
    <param name="yaw_tolerance" value="0.15" type="double"/>
    <param name="aruco/timeout_ms" value="20000" type="int"/>

    <!-- 安全边界参数 -->
    <param name="safety/enabled" value="true" type="bool"/>
    <param name="safety/x_min" value="-1.0" type="double"/>
    <param name="safety/x_max" value="6.0" type="double"/>
    <param name="safety/y_min" value="-3.0" type="double"/>
    <param name="safety/y_max" value="3.0" type="double"/>
    <param name="safety/z_min" value="-0.1" type="double"/>
    <param name="safety/z_max" value="2.5" type="double"/>

    <!-- ============================================ -->
    <!-- 任务航点坐标配置 (ENU: x=东/右, y=北/前, z=上) -->
    <!-- 比赛前根据实际场地调整                          -->
    <!-- ============================================ -->

    <!-- 起飞 -->
    <param name="takeoff/goal" value="0.0;0.0;1.0" type="str"/>

    <!-- 穿越方框 -->
    <param name="cross_frame/observe_pos"        value="0.0;-1.0;1.0"  type="str"/>    <!-- 观察位置 -->
    <param name="cross_frame/observe_delay_ms"    value="1000"          type="double"/> <!-- 到达后等待时间(ms) -->
    <param name="cross_frame/object_width"        value="1.3"          type="double"/> <!-- 方框物理宽度(m) -->
    <param name="cross_frame/object_height"       value="1.3"          type="double"/> <!-- 方框物理高度(m) -->
    <param name="cross_frame/occlusion_direction" value="right"         type="str"/>    <!-- 遮挡方向 -->
    <param name="cross_frame/expected_pos"        value="3.25;-0.4;1.0" type="str"/>    <!-- 方框预期位置 -->
    <param name="cross_frame/z_tolerance"         value="0.5"           type="double"/> <!-- z方向容差 -->
    <param name="cross_frame/filter_window_size"  value="20"            type="double"/> <!-- 滤波窗口 -->
    <param name="cross_frame/offset_z"            value="1.0"           type="double"/> <!-- 规划z偏移 -->

    <!-- ArUco 检测 -->
    <param name="aruco/hover_pos" value="4.5;0.5;1.2" type="str"/>     <!-- 二维码上方悬停位置 -->

    <!-- 返回穿越方框 -->
    <param name="return_cross_frame/turn_pos"     value="4.5;0.5;1.8"   type="str"/>    <!-- 转向位置 -->
    <param name="return_cross_frame/turn_yaw"     value="3.14159"        type="double"/> <!-- 转向航向(rad) -->
    <param name="return_cross_frame/body_forward"  value="0.2;0.0;0.0"   type="str"/>    <!-- 机体系前进距离 -->
    <param name="return_cross_frame/offset_z"      value="1.0"           type="double"/> <!-- 反向穿框偏移 -->

    <!-- 降落 / 返航 -->
    <param name="land/return_high_pos" value="0.0;0.0;1.4" type="str"/> <!-- 规划返航到起点上方 -->
    <param name="land/return_low_pos"  value="0.0;0.0;0.5" type="str"/> <!-- 降落前低位点 -->
    <param name="land/return_yaw" value="0.0" type="double"/>         <!-- 降落前航向(rad) -->
    <param name="land/planning_yaw_rate" value="0.25" type="double"/> <!-- 返航规划时机头转向速度(rad/s) -->
    <param name="land/final_yaw_rate" value="0.25" type="double"/>    <!-- 降落前原地转向速度(rad/s) -->

    <!-- ============================================ -->
    <!-- 气球颜色→区域映射（比赛前根据实际配置修改）    -->
    <!-- ============================================ -->
    <param name="balloon_color_red"    value="A" type="str"/>
    <param name="balloon_color_blue"   value="C" type="str"/>
    <param name="balloon_color_purple" value="B" type="str"/>

    <!-- ============================================ -->
    <!-- 穿回框后掉头朝向                               -->
    <!-- ============================================ -->
    <param name="return_cross_frame/exit_yaw" value="0.0" type="double"/>

    <!-- ============================================ -->
    <!-- 气球打击区域配置（比赛前调整）                   -->
    <!-- approach_pos: PlanningControl 规划飞到的接近点  -->
    <!-- goal: 到达后转向的位置                          -->
    <!-- yaw:  到达位置时的机头朝向 (rad)                -->
    <!-- ============================================ -->
    <!-- A区 (红色气球) -->
    <param name="balloon_zone_A/approach_pos" value="5.3;1.1;1.0"  type="str"/>
    <param name="balloon_zone_A/goal"         value="5.3;1.1;0.70" type="str"/>
    <param name="balloon_zone_A/yaw"          value="3.14159"       type="double"/>
    <param name="balloon_zone_A/hit_offset_x" value="35.0" type="double"/>
    <param name="balloon_zone_A/corridor_reference_length" value="5.20" type="double"/>
    <param name="balloon_zone_A/sprint_limit_ratio" value="0.86" type="double"/>
    <param name="balloon_zone_A/target_zone_far_ratio" value="0.78" type="double"/>
    <param name="balloon_zone_A/wait_entry_ratio" value="0.35" type="double"/>
    <param name="balloon_zone_A/post_hit_escape_yaw" value="-1.5708" type="double"/>
    <!-- B区 (紫色气球) -->
    <param name="balloon_zone_B/approach_pos" value="5.3;-2.60;1.0" type="str"/>
    <param name="balloon_zone_B/goal"         value="5.3;-2.60;0.70" type="str"/>
    <param name="balloon_zone_B/search_pos"   value="5.3;-2.60;0.70" type="str"/>
    <param name="balloon_zone_B/yaw"          value="3.14159"       type="double"/>
    <param name="balloon_zone_B/hit_offset_x" value="-10.0" type="double"/>
    <param name="balloon_zone_B/corridor_reference_length" value="5.20" type="double"/>
    <param name="balloon_zone_B/sprint_limit_ratio" value="0.78" type="double"/>
    <param name="balloon_zone_B/target_zone_far_ratio" value="0.78" type="double"/>
    <param name="balloon_zone_B/wait_entry_ratio" value="0.0" type="double"/>
    <param name="balloon_zone_B/emergency_clearance" value="0.0" type="double"/>
    <param name="balloon_zone_B/boundary_margin" value="0.20" type="double"/>
    <param name="balloon_zone_B/post_hit_escape_yaw" value="1.5708" type="double"/>
    <param name="balloon_zone_B/post_hit_escape_distance" value="0.25" type="double"/>
    <param name="balloon_zone_B/post_hit_escape_time" value="1.50" type="double"/>
    <!-- C区 (蓝色气球) -->
    <param name="balloon_zone_C/approach_pos" value="5.4;1.0;1.0"  type="str"/>
    <param name="balloon_zone_C/goal"         value="5.4;1.0;0.70" type="str"/>
    <param name="balloon_zone_C/yaw"          value="-1.5708"       type="double"/>
    <param name="balloon_zone_C/hit_offset_x" value="-45.0" type="double"/>
    <param name="balloon_zone_C/corridor_reference_length" value="5.00" type="double"/>
    <param name="balloon_zone_C/sprint_limit_ratio" value="0.76" type="double"/>
    <param name="balloon_zone_C/target_zone_far_ratio" value="0.76" type="double"/>
    <param name="balloon_zone_C/wait_entry_ratio" value="0.35" type="double"/>
    <param name="balloon_zone_C/emergency_clearance" value="0.0" type="double"/>
    <param name="balloon_zone_C/post_hit_escape_yaw" value="3.14159" type="double"/>

    <!-- ============================================ -->
    <!-- VisualServo 视觉伺服参数（与手调 XML 一致）     -->
    <!-- ============================================ -->
    <param name="visual_servo/k_p_yaw_rate"            value="0.004" type="double"/>
    <param name="visual_servo/k_d_yaw_rate"            value="0.001" type="double"/>
    <param name="visual_servo/k_p_vz"                  value="0.015" type="double"/>
    <param name="visual_servo/k_d_vz"                  value="0.006" type="double"/>
    <param name="visual_servo/approach_area_threshold"  value="0.035"  type="double"/>
    <param name="visual_servo/post_hit_success_area_ratio" value="0.025" type="double"/>
    <param name="visual_servo/forward_velocity"         value="0.9"   type="double"/>
    <param name="visual_servo/sprint_velocity"          value="0.85"  type="double"/>
    <param name="visual_servo/sprint_time"              value="6.0"   type="double"/>
    <param name="visual_servo/hit_offset_x"             value="50.0"  type="double"/>
    <param name="visual_servo/hit_offset_y"             value="0.0"   type="double"/>
    <param name="visual_servo/hit_offset_reference_depth" value="0.80" type="double"/>
    <param name="visual_servo/max_hit_offset_ratio"       value="0.35" type="double"/>
    <param name="visual_servo/sprint_lift_velocity"     value="0.0"  type="double"/>
    <param name="visual_servo/sprint_lock_visual_correction" value="true" type="bool"/>
    <param name="visual_servo/post_hit_brake_velocity"  value="0.0"   type="double"/>
    <param name="visual_servo/post_hit_brake_time"      value="1.5"   type="double"/>
    <param name="visual_servo/post_hit_lift_height"     value="0.35"  type="double"/>
    <param name="visual_servo/post_hit_lift_time"       value="0.45"  type="double"/>
    <param name="visual_servo/post_hit_lift_timeout"    value="1.0"   type="double"/>
    <param name="visual_servo/post_hit_lift_tolerance"  value="0.12"  type="double"/>
    <param name="visual_servo/post_hit_settle_time"     value="0.45"  type="double"/>
    <param name="visual_servo/post_hit_escape_velocity" value="0.18" type="double"/>
    <param name="visual_servo/post_hit_escape_distance" value="0.10" type="double"/>
    <param name="visual_servo/post_hit_escape_time"     value="0.60" type="double"/>
    <param name="visual_servo/post_hit_escape_yaw_rate" value="0.12" type="double"/>
    <param name="visual_servo/data_timeout"              value="0.50"   type="double"/>
    <param name="visual_servo/startup_grace_time"        value="1.0"    type="double"/>
    <param name="visual_servo/strike_stable_time"        value="0.15"   type="double"/>
    <param name="visual_servo/sprint_alignment_tolerance_px" value="24.0" type="double"/>
    <param name="visual_servo/sprint_vertical_alignment_tolerance_px" value="180.0" type="double"/>
    <param name="visual_servo/sprint_alignment_stable_frames" value="2" type="int"/>
    <param name="visual_servo/sprint_altitude_tolerance" value="0.04" type="double"/>
    <param name="visual_servo/sprint_vertical_speed_tolerance" value="0.06" type="double"/>
    <param name="visual_servo/sprint_altitude_hold_gain" value="1.5" type="double"/>
    <param name="visual_servo/sprint_max_vertical_correction" value="0.08" type="double"/>
    <param name="visual_servo/sprint_target_loss_grace"  value="1.50"   type="double"/>
    <!-- 在0.70m发现目标后立即下降，并同步完成侧桨偏置对准 -->
    <param name="visual_servo/strike_altitude"            value="0.40"   type="double"/>
    <param name="visual_servo/descent_velocity"           value="0.22"   type="double"/>
    <param name="visual_servo/descent_tolerance"          value="0.05"   type="double"/>
    <param name="visual_servo/descent_timeout"            value="4.0"    type="double"/>
    <param name="visual_servo/heading_hold_gain"          value="1.5"    type="double"/>
    <param name="visual_servo/heading_hold_max_rate"      value="0.30"   type="double"/>
    <param name="visual_servo/wait_velocity"              value="0.16"   type="double"/>
    <param name="visual_servo/wait_timeout"               value="12.0"   type="double"/>
    <param name="visual_servo/wait_no_target_timeout"     value="0.5"    type="double"/>
    <param name="visual_servo/wait_contact_distance"      value="0.42"   type="double"/>
    <!-- 深度点云关联气球及其低位载车；墙、地面和立柱仍是硬障碍 -->
    <param name="visual_servo/depth_timeout"              value="0.20"   type="double"/>
    <param name="visual_servo/depth_min_points"           value="8"      type="int"/>
    <param name="visual_servo/target_depth_band"          value="0.22"   type="double"/>
    <param name="visual_servo/target_depth_quantile"      value="0.30"   type="double"/>
    <param name="visual_servo/target_bbox_margin_px"      value="5.0"    type="double"/>
    <param name="visual_servo/target_zone_near_distance"  value="0.15"   type="double"/>
    <param name="visual_servo/target_zone_far_ratio"      value="0.80"   type="double"/>
    <param name="visual_servo/target_zone_lateral_limit"  value="0.55"   type="double"/>
    <param name="visual_servo/target_zone_fallback_area_ratio" value="0.002" type="double"/>
    <param name="visual_servo/target_closing_speed_threshold" value="0.15" type="double"/>
    <param name="visual_servo/target_ttc_threshold"       value="2.0"    type="double"/>
    <param name="visual_servo/target_intercept_margin_px" value="12.0"   type="double"/>
    <param name="visual_servo/target_carrier_depth_margin" value="0.55"  type="double"/>
    <param name="visual_servo/target_carrier_below_margin_px" value="120.0" type="double"/>
    <param name="visual_servo/corridor_half_width"        value="0.38"   type="double"/>
    <param name="visual_servo/corridor_half_height"       value="0.32"   type="double"/>
    <param name="visual_servo/emergency_clearance"        value="0.48"   type="double"/>
    <param name="visual_servo/contact_distance"           value="0.35"   type="double"/>
    <param name="visual_servo/braking_acceleration"       value="0.8"    type="double"/>
    <param name="visual_servo/control_latency"            value="0.15"   type="double"/>
    <param name="visual_servo/min_attack_altitude"        value="0.30"   type="double"/>
    <param name="visual_servo/altitude_guard_margin"      value="0.05"   type="double"/>
    <param name="visual_servo/altitude_recovery_speed"    value="0.18"   type="double"/>
    <param name="visual_servo/boundary_margin"            value="0.40"   type="double"/>
    <!-- 命中后沿冲刺方向零速制动；未命中则停稳后进入等待区 -->
    <param name="visual_servo/brake_speed_threshold"      value="0.12"   type="double"/>
    <param name="visual_servo/brake_hold_time"            value="0.30"   type="double"/>
    <param name="visual_servo/brake_timeout"              value="1.50"   type="double"/>
    <!-- 目标丢失后的主动恢复参数 -->
    <param name="visual_servo/recovery_delay"            value="0.1"   type="double"/>
    <param name="visual_servo/recovery_backoff_velocity" value="0.0" type="double"/>
    <param name="visual_servo/recovery_backoff_time"     value="0.0" type="double"/>
    <param name="visual_servo/recovery_yaw_rate"         value="0.5"   type="double"/>
    <param name="visual_servo/recovery_total_timeout"    value="3.0"   type="double"/>
    <param name="balloon_detection/confidence_threshold" value="0.60" type="double"/>
    <param name="target_tracker/lost_target_grace_time" value="1.5" type="double"/>

    <!-- ============================================ -->
    <!-- 打击前主动扫描参数                            -->
    <!-- ============================================ -->
    <param name="balloon_scan/yaw_rate"             value="0.35" type="double"/>
    <param name="balloon_scan/timeout"              value="45.0" type="double"/>
    <param name="balloon_scan/center_gate_x_ratio"  value="0.35" type="double"/>
    <param name="balloon_scan/center_gate_y_ratio"  value="0.45" type="double"/>
    <param name="balloon_scan/stable_frames"        value="1"    type="int"/>
    <param name="balloon_scan/detection_hold_time"  value="0.0"  type="double"/>
    <param name="balloon_scan/phase_duration"       value="2.5"  type="double"/>
    <param name="balloon_scan/lateral_velocity"     value="0.0" type="double"/>
    <param name="balloon_scan/backward_velocity"    value="0.0" type="double"/>
    <param name="balloon_scan/retry_attempts"       value="1"    type="int"/>
    <param name="balloon_scan/staging_tolerance"     value="0.10" type="double"/>
    <param name="balloon_scan/staging_yaw_tolerance" value="0.15" type="double"/>
    <param name="balloon_scan/staging_settle_ms"     value="0"    type="int"/>


    <!-- 运行任务节点（LLM 模式） -->
    <node pkg="mission_pkg" type="bt_ros" name="llm_mission_node" output="screen">
        <param name="mode" value="llm" type="str"/>
    </node>

    <!-- 日志录制（可选，默认关闭） -->
    <arg name="enable_logging" default="false"/>
    
    <node if="$(arg enable_logging)" 
          pkg="rosbag" 
          type="record" 
          name="mission_logger"
          args="/mavros/local_position/odom 
                /mavros/state 
                /mavros/setpoint_raw/local 
                /objects 
                /planning/pos_cmd 
                /move_base_simple/goal 
                /mission_command 
                /mission_result 
                -o $(find mission_pkg)/../../logs/llm_mission_"/>
</launch>
