<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="HitBalloon">
  
  <BehaviorTree ID="HitBalloon">
    <Sequence name="MainLoop">
      <!-- 1. 起飞到 1.0 米高度 -->
      <Takeoff goal="0.0;-0.9;1.0" auto_arm="0" tolerance="0.1"/>
      
      <!-- 2. 在固定XY下降到搜索高度，并确认位置与初始航向 -->
      <GoTo goal="0.0;-0.9;0.70" yaw="-1.570796" tolerance="0.10" yaw_tolerance="0.15" yaw_rate="0.50"/>
      
      <!-- 3. 实时跟踪气球并视觉伺服撞击 -->
      <!-- 低空搜索，发现后完成侧桨偏置对准并水平直线冲刺 -->
      <ForceSuccess>
      <RetryUntilSuccessful num_attempts="1">
        <Sequence name="AcquireAndHit">
          <!-- 主动旋转扫描，先把目标拉进视野 -->
          <ScanForTarget object_name="red_balloon" confidence_threshold="0.6" yaw_rate="0.0" timeout="45.0" center_gate_x_ratio="0.35" center_gate_y_ratio="0.45" stable_frames="1" detection_hold_time="0.0" phase_duration="2.5" lateral_velocity="0.0" backward_velocity="0.0" />

          <!-- 跟踪并撞击气球 -->
            <Timeout msec="50000">
              <Parallel success_count="1" failure_count="1">

                <!-- 持续跟踪：实时计算气球像素坐标 -->
                <TargetTracker
                    object_name="red_balloon"
                    confidence_threshold="0.6"
                    pixel_target="{balloon_pixel}" lost_target_grace_time="1.5" />

                <!-- 视觉伺服：VX+VZ+yaw_rate PD控制 -->
                <VisualServo
                    pixel_target="{balloon_pixel}"
                    k_p_yaw_rate="0.006"
                    k_d_yaw_rate="0.002"
                    k_p_vz="0.015"
                    k_d_vz="0.006"
                    approach_area_threshold="0.035"
                    forward_velocity="0.35"
                    sprint_velocity="0.85"
                    sprint_time="6.0"
                    sprint_lock_visual_correction="false"
                    hit_offset_x="25.0"
                    hit_offset_reference_depth="0.80"
                    max_hit_offset_ratio="0.35"
                    corridor_reference_length="5.20"
                    target_zone_far_ratio="0.78"
                    sprint_limit_ratio="0.86"
                    wait_entry_ratio="0.35"
                    strike_altitude="0.40"
                    descent_velocity="0.22"
                    descent_tolerance="0.02"
                    descent_timeout="4.0"
                    heading_hold_gain="1.5"
                    heading_hold_max_rate="0.30"
                    wait_velocity="0.16"
                    wait_timeout="12.0"
                    wait_no_target_timeout="0.5"
                    wait_contact_distance="0.42"
                    hit_area_ratio="0.35"
                    center_exit_factor="1.5"
                    post_hit_brake_velocity="0.35"
                    post_hit_brake_time="0.35"
                    post_hit_settle_time="0.45"
                    post_hit_lift_height="0.35"
                    post_hit_lift_time="0.45"
                    post_hit_lift_timeout="1.0"
                    post_hit_lift_tolerance="0.12"
                    post_hit_escape_yaw="-1.5708"
                    post_hit_escape_velocity="0.18"
                    post_hit_escape_distance="0.10"
                    post_hit_escape_time="0.60"
                    post_hit_escape_yaw_rate="0.12"
                    data_timeout="0.50"
                    recovery_delay="0.1"
                    recovery_backoff_velocity="0.0"
                    recovery_backoff_time="0.0"
                    recovery_yaw_rate="0.5"
                    recovery_total_timeout="3.0"
                    startup_grace_time="1.0" strike_stable_time="0.15"
                    sprint_alignment_tolerance_px="24.0" sprint_vertical_alignment_tolerance_px="180.0"
                    sprint_alignment_stable_frames="2" sprint_altitude_tolerance="0.04"
                    sprint_vertical_speed_tolerance="0.06" sprint_altitude_hold_gain="1.5"
                    sprint_max_vertical_correction="0.08"
                    sprint_target_loss_grace="1.50"
                    depth_timeout="0.20" depth_min_points="8" target_depth_band="0.22"
                    corridor_half_width="0.38" corridor_half_height="0.32"
                    emergency_clearance="0.48" contact_distance="0.35"
                    min_attack_altitude="0.30" altitude_guard_margin="0.05" boundary_margin="0.40"
                    brake_speed_threshold="0.12" brake_hold_time="0.30" brake_timeout="1.80" />
              </Parallel>
            </Timeout>
        </Sequence>
      </RetryUntilSuccessful>
      </ForceSuccess>
      
      <!-- 4. 规划返回起点 -->
      <PlanningControl goal="0.0;0.0;1.2" use_home_xy="true" control_yaw="true" />
      
      <!-- 5. 降落 -->
      <Land use_speed="0" />
    </Sequence>
  </BehaviorTree>

</root>
